# Public site origin used for canonical URLs, social metadata, sitemap and robots.txt.
# Current production origin on Vercel. Change only when the production domain changes.
NEXT_PUBLIC_SITE_URL=https://tocfl-learning-web.vercel.app

# Supabase Project URL and publishable (public) key. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after Facebook Login is configured in Supabase and Meta.
NEXT_PUBLIC_FACEBOOK_OAUTH_ENABLED=false
